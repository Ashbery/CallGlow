<?xml version="1.0" encoding="utf-8"?>
<!-- docs/ui-spec.md V2-1：黑底、LINE 綠 accent、圓形安全區（內容置中） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_round_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/bt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_strength_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/strength_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/strength_weak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_strength_weak"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/strength_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_strength_medium"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/strength_strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_strength_strong"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_pattern_label"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/pattern_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/pattern_rapid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_pattern_rapid"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/pattern_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_pattern_medium"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/pattern_long"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_pattern_long"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </RadioGroup>

        <Switch
            android:id="@+id/switch_system_effect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_use_system_effect"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/vib_mode_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/mode_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_click"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mode_double_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_double_click"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mode_tick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_tick"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/mode_heavy_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_heavy_click"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </RadioGroup>

        <Button
            android:id="@+id/btn_test_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/line_green"
            android:text="@string/btn_test_call"
            android:textColor="@color/watch_black" />

        <Button
            android:id="@+id/btn_test_missed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/line_green"
            android:text="@string/btn_test_missed"
            android:textColor="@color/watch_black" />

        <Button
            android:id="@+id/btn_test_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/line_green"
            android:text="@string/btn_test_stop"
            android:textColor="@color/watch_black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxWidth="220dp"
            android:text="@string/settings_boot_note"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
