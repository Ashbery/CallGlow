<?xml version="1.0" encoding="utf-8"?>
<!-- docs/ui-spec.md v3.6：幾何對齊布局——頭像圓心=屏高42%(98dp)、光環頂=64dp；
     頂部對齊（不用 gravity=CENTER 溢出模式）；下方標題+14/名字+10/副標+8；includeFontPadding=false -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_round_black"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.linewatch.watch.StarfieldView
        android:id="@+id/starfield_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- D17 銀河：極光光暈（星雲流動）＋螢幕邊緣呼吸光環 -->
    <com.linewatch.watch.AuroraView
        android:id="@+id/aurora"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.linewatch.watch.EdgeHaloView
        android:id="@+id/edge_halo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="0dp"
        android:paddingTop="18dp"
        android:paddingRight="0dp"
        android:paddingBottom="0dp">

        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.linewatch.watch.RippleView
                android:id="@+id/ripple"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center" />

            <View
                android:id="@+id/glow"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:alpha="0.2"
                android:background="@drawable/bg_glow" />

            <View
                android:id="@+id/ring_outer"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:alpha="0.15"
                android:background="@drawable/bg_ring" />

            <View
                android:id="@+id/ring_inner"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:alpha="0.55"
                android:background="@drawable/bg_ring_inner" />

            <TextView
                android:id="@+id/avatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:includeFontPadding="false"
            android:text="@string/title_incoming"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoSizeMaxTextSize="28sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:text="@string/subtitle_vibrating"
            android:textColor="@color/line_green"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
